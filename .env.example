# Copie en .env (racine) :  cp .env.example .env
# DATABASE_URL     : rôle admin (postgres) — migrations Prisma uniquement.
# APP_DATABASE_URL : rôle applicatif app_user (NON superuser) — runtime + tests.
#                    La RLS ne s'applique qu'aux rôles non-superuser : l'app ne doit
#                    JAMAIS tourner avec le rôle postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
APP_DATABASE_URL=postgresql://app_user:app_password@localhost:5432/appdb

# Auth (better-auth). AUTH_SECRET : générer avec `openssl rand -hex 32` ;
# obligatoire en production (le défaut de dev est refusé).
AUTH_SECRET=dev-secret-change-me
AUTH_BASE_URL=http://localhost:8080
