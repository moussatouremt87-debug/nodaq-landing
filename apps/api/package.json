{
  "name": "@nodaq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed:demo": "tsx src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@nodaq/agent-runtime": "workspace:*",
    "@nodaq/db": "workspace:*",
    "@nodaq/fec": "workspace:*",
    "@nodaq/llm": "workspace:*",
    "@nodaq/mcp-connectors": "workspace:*",
    "@nodaq/secrets": "workspace:*",
    "@nodaq/shared": "workspace:*",
    "better-auth": "^1.6.25",
    "fastify": "^5.2.0",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "web-push": "^3.6.7",
    "zod": "^3.24.1",
    "@nodaq/facturx": "workspace:*"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
