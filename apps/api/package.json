    "@nodaq/shared": "workspace:*",
    "better-auth": "^1.6.25",
    "fastify": "^5.2.0",
    "zod": "^3.24.1",
    "@nodaq/fec": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
