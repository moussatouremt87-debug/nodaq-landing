# Overrides Claude Code perso (non versionnés)
.claude/settings.local.json

# Secrets & environnement (les .env.example restent versionnés)
.env
.env.*
!.env.example
*.pem

# Dépendances & builds (pour les futures phases du monorepo)
node_modules/
dist/
.next/
.turbo/
__pycache__/
.venv/
*.tsbuildinfo

# Coffre local de dev (FileSecretProvider — jamais un vrai store)
.dev-vault.json*

# Terraform (infra/) — state et caches, jamais commités
.terraform/
*.tfstate*
*.tfvars
*.tfvars.json
infra/crash*.log
