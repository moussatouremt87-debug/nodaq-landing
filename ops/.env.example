# Copie ce fichier en .env :  cp .env.example .env
# Les valeurs par défaut suffisent pour le dev local. NE COMMITE JAMAIS .env réel.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb

# ── MinIO (Object Storage local S3) ─────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# ── ClickHouse (backend Langfuse) ───────────────────────────────────────────
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# ── LiteLLM ─────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-local-master
# Clés fournisseurs souverains (laisser vide si tu n'appelles pas encore les modèles)
SCW_GENERATIVE_API_KEY=
MISTRAL_API_KEY=

# ── Langfuse (secrets générés ; régénère-les pour un vrai déploiement) ───────
LANGFUSE_ENCRYPTION_KEY=0c213ca6f558cce9f5eec716cbeb8d1f848d0c491f41211c35bbe3a0d59b19ab
LANGFUSE_SALT=97e58f5c3be7685fd93c20fc2f57a23b
LANGFUSE_NEXTAUTH_SECRET=10c0852201223b3124f0769a3ee269c78463c6c1a0de92250ae13db4012507f0

# ── Runtime agents (à utiliser côté apps/agent-runtime, pas dans le compose) ─
# ANTHROPIC_API_KEY=

# ── Notifications push Web (2.17) — clés VAPID (coffre en prod) ──────────────
# Génération locale : npx web-push generate-vapid-keys
# Absentes : la feature dégrade proprement (routes 503, aucun envoi).
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:contact@nodaq.fr

# ── Canal support par e-mail (2.18) — tout optionnel, coffre en prod ─────────
# Boîte FR/UE (OVH, Infomaniak…) ; absente = canal support inactif.
# SUPPORT_IMAP_HOST=
# SUPPORT_IMAP_PORT=993
# SUPPORT_IMAP_USER=support@nodaq.fr
# SUPPORT_IMAP_PASSWORD=
# Object Storage fr-par (MinIO en local : http://localhost:9000, bucket à créer)
# SUPPORT_S3_ENDPOINT=
# SUPPORT_S3_BUCKET=nodaq-support
# SUPPORT_S3_ACCESS_KEY=
# SUPPORT_S3_SECRET_KEY=
# Envoi des réponses (Scaleway TEM) ; absent = validation d'envoi en 503.
# Clé IAM DÉDIÉE TEM (jamais la clé maîtresse du coffre).
# SUPPORT_FROM_EMAIL=support@nodaq.fr
# SUPPORT_TEM_SECRET_KEY=
# Rôle plateforme OPERATOR (back-office /ops/support) : USER IDS (voir /me),
# séparés par virgule — jamais des e-mails (revendicables par sign-up).
# OPS_OPERATOR_USER_IDS=
