{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(uv run *)",
      "Bash(pnpm prisma *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log --oneline*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Read(src/**)",
      "Read(**/*.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.*.local)",
      "Read(**/.env.*.local)",
      "Read(.env.production*)",
      "Read(**/.env.production*)",
      "Read(.env.staging*)",
      "Read(**/.env.staging*)",
      "Read(.env.development*)",
      "Read(**/.env.development*)",
      "Read(.env.test*)",
      "Read(**/.env.test*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-touched.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-reminder.sh"
          }
        ]
      }
    ]
  }
}
