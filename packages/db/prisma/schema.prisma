generator client {
  provider = "prisma-client-js"
  // "native" (dev/CI) + cible EXPLICITE du runtime Docker (node:22-slim =
  // Debian 12 / OpenSSL 3). Sans elle, un build sans openssl installé génère
  // le moteur pour openssl-1.1.x par défaut -> crash au boot du conteneur
  // ("Prisma Client was generated for debian-openssl-1.1.x…").
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // "ops" (2.18) : tables de support back-office — exception ASSUMÉE à la RLS
  // métier (voir CLAUDE.md) : accès réservé aux routes OPERATOR, jamais aux
  // routes tenant, et JAMAIS un corps d'e-mail brut en base (Object Storage).
  schemas  = ["public", "ops"]
}

/// Tenant = better-auth "organization" (plugin organization, mapped via modelName).
/// slug/logo/metadata are owned by the plugin; slug is unique (checked on create).
model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String?      @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  invitations Invitation[]
  notes       Note[]
  classifications Classification[]
  policy      TenantPolicy?
  connectors  Connector[]
  documents       Document[]
  documentChunks  DocumentChunk[]
  pendingActions  PendingAction[]
  agentConversations AgentConversation[]
  fecImports      FecImport[]
  fecInvoices     FecInvoice[]
  classeurDocuments ClasseurDocument[]
  stockItems      StockItem[]
  stockMovements  StockMovement[]
  pushSubscriptions   PushSubscription[]
  pushDispatchStates  PushDispatchState[]
  fixedAssets         FixedAsset[]

  @@map("tenants")
  @@schema("public")
}

/// Tables d'authentification (better-auth) : users, sessions, accounts, verifications.
/// Plan AUTH (pas métier) : un user peut appartenir à plusieurs tenants via memberships,
/// donc pas de tenant_id ni de RLS ici — le cloisonnement métier se fait via
/// memberships + withTenant (RLS) sur les tables métier.
model User {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @default("")
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
  invitations   Invitation[]

  @@map("users")
  @@schema("public")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  token                String   @unique
  userId               String   @map("user_id") @db.Uuid
  /// Active organization (= tenant) of the session — the ONLY source of tenantId
  /// for business routes. Set by the organization plugin (set-active) or the
  /// session-create database hook.
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  expiresAt            DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("public")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
  @@schema("public")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
  @@schema("public")
}

/// Membership = better-auth "member". Roles: owner | member | accountant
/// (plugin access control — string column, validated by the MembershipRole Zod
/// schema in @nodaq/shared at app boundaries).
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("memberships")
  @@schema("public")
}

/// Invitation = better-auth "invitation" (organization plugin). Auth-plane table
/// (like memberships): accessed by the plugin outside withTenant, so no RLS.
model Invitation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String
  role      String?
  status    String   @default("pending")
  teamId    String?  @map("team_id")
  inviterId String   @map("inviter_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter   User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("invitations")
  @@schema("public")
}

/// Table métier de démonstration : scellée par RLS (voir la migration `rls_notes`).
/// Toute nouvelle table métier suit le même pattern : tenant_id + policy RLS + test d'isolation.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notes")
  @@schema("public")
}

/// RGPD audit trail of model routing decisions: which sensitivity category and
/// model tier a request was routed to, and by which mechanism (rules vs. LLM
/// classifier). Sealed by RLS (see the migration `rls_classifications_and_policies`).
/// Never stores the request content — only a hash — so this table is safe to keep
/// long-term for audit purposes.
model Classification {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  requestId   String   @map("request_id")
  /// 'confidentiel' | 'interne' | 'non_sensible' — validated app-side by Zod.
  category    String
  /// Model group chosen for this request (e.g. 'sovereign-fast').
  tier        String
  /// 'rules' | 'llm' — which mechanism decided the category.
  decidedBy   String   @map("decided_by")
  /// 'allowed' | 'blocked' (sovereignty guard) | 'failed' (model call error) —
  /// blocked attempts MUST leave a trace too (RGPD audit finding 1.1).
  outcome     String   @default("allowed")
  /// sha256 of the request text — never the content itself.
  contentHash String   @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("classifications")
  @@schema("public")
}

/// Registry of connected SaaS connectors per tenant (blueprint §5.6, e.g. Pennylane,
/// Qonto). Sealed by RLS (see the migration `20260725120548_connectors`). `credentialsRef` is
/// the NAME of the secret in the Secret Manager — never a credential value.
model Connector {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// 'pennylane' | 'qonto' | 'bridge' — validated app-side by Zod.
  type            String
  /// Secret NAME in the vault (Scaleway Secret Manager in prod) — never the credential itself.
  credentialsRef  String   @map("credentials_ref")
  /// 'active' | 'disabled' | 'demo' | 'file' (import FEC) — validé côté app. 'demo' n'est posé QUE
  /// par le script de seed démo (clients-fixtures, jamais une vraie connexion) ;
  /// l'API d'onboarding ne crée que 'active'.
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("connectors")
  @@schema("public")
}

/// Per-tenant model routing policy. Sealed by RLS (see the migration
/// `rls_classifications_and_policies`).
model TenantPolicy {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  /// Whether this tenant is allowed to route non-sensitive requests to frontier
  /// (non-sovereign) model providers.
  frontierEnabled  Boolean  @default(false) @map("frontier_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_policies")
  @@schema("public")
}

/// RAG ingestion tracking: one row per source document ingested for a tenant.
/// Sealed by RLS (see the migration `rls_documents`). `objectKey` is the Object
/// Storage key (provenance) — the raw file itself lives in S3, never in Postgres.
/// `hash` (sha256 of the raw file) is the idempotency key per tenant: re-ingesting
/// the same file for the same tenant is a no-op.
model Document {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// Object Storage key (provenance) — optional (e.g. not yet uploaded, or ingested
  /// straight from a connector without persisting the raw file).
  objectKey  String?   @map("object_key")
  /// Department scope — validated app-side (Zod), not a DB enum.
  dept       String
  /// 'UPLOAD' | 'CONNECTOR' — validated app-side.
  source     String    @default("UPLOAD")
  /// sha256 of the raw file — idempotency key (see @@unique below).
  hash       String
  indexedAt  DateTime? @map("indexed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  @@unique([tenantId, hash])
  @@index([tenantId])
  @@map("documents")
  @@schema("public")
}

/// RAG vector store: one row per chunk of a `Document`, with its embedding.
/// Sealed by RLS (see the migration `rls_documents`).
/// IMPORTANT: the embedding dimension (1024) MUST stay in sync with
/// EMBEDDING_DIM in `services/rag` (bge-m3) — changing one without the other
/// breaks ingestion/search silently (dimension mismatch at insert time).
model DocumentChunk {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  chunkIndex Int       @map("chunk_index")
  content    String
  /// pgvector column, dim 1024 (bge-m3) — see the note above on the model doc.
  /// Prisma's `Unsupported` type: no client-side CRUD on this field, raw SQL only.
  embedding  Unsupported("vector(1024)")?
  dept       String
  source     String    @default("UPLOAD")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([tenantId])
  // NOTE: no @@index declaration for the HNSW vector index here — the installed
  // Prisma engine (6.19.3) doesn't support the `Hnsw` index type at the schema
  // level (`Unknown index type: Hnsw` on `prisma validate`). The index is created
  // via raw SQL in the `rag_documents` migration and `document_chunks` is marked
  // as an externally-managed table in `prisma.config.ts` (`tables.external`) so
  // `prisma migrate dev` doesn't perpetually try to reconcile/drop it as drift.
  @@map("document_chunks")
  @@schema("public")
}

/// Human-in-the-loop validation queue (blueprint §5.4/§6, CLAUDE.md rule 4): every
/// write-side MCP tool (`send_*`, `create_*`, `submit_*`) creates a `PendingAction`
/// instead of executing directly. A human validates it in one click; `validatedBy`
/// is the legal attribution of who approved it. Sealed by RLS (see the migration
/// `rls_pending_actions`).
model PendingAction {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// e.g. 'book_invoice', 'send_dunning' — validated app-side by Zod.
  type         String
  /// The prepared action, ready to execute after approval.
  payload      Json
  /// 'pending' | 'approved' | 'rejected' | 'executed' | 'failed' — validated app-side.
  status       String    @default("pending")
  /// The user or agent run that prepared the action.
  requestedBy  String?   @map("requested_by") @db.Uuid
  /// Which virtual employee prepared this action (e.g. 'compta'). Nullable: a human
  /// can also submit an action directly.
  employee     String?
  /// The HUMAN who clicked to approve/reject — legal attribution, never an agent.
  validatedBy  String?   @map("validated_by") @db.Uuid
  validatedAt  DateTime? @map("validated_at")
  /// When post-approval execution actually happened (set once, by the executor).
  executedAt   DateTime? @map("executed_at")
  /// Execution outcome metadata only (e.g. external id, error code) — NEVER
  /// sensitive client content.
  result       Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("pending_actions")
  @@schema("public")
}

/// Persisted conversation transcripts of virtual employees (blueprint agentic
/// runtime), enabling resume-after-restart. Sealed by RLS (see the migration
/// `agent_runtime`) — `messages` is the full transcript and may contain sensitive
/// client content, exactly like `notes`.
model AgentConversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Which virtual employee owns this conversation, e.g. 'compta'.
  employee  String
  /// Full conversation transcript (sensitive: sealed by RLS, never logged).
  messages  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("agent_conversations")
  @@schema("public")
}

/// Ticket 2.14 — import FEC (données CONFIDENTIELLES : dérivées du journal
/// comptable). Écriture uniquement via le script d'import, lecture via
/// withTenant. One row per imported FEC file; `fileHash` (sha256) is the
/// idempotency key per tenant — re-importing the same file is a no-op.
/// Sealed by RLS (see the migration `rls_fec_import`).
model FecImport {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  /// sha256 of the raw FEC file — idempotency key (see @@unique below).
  fileHash      String       @map("file_hash")
  fileName      String?      @map("file_name")
  entryCount    Int          @map("entry_count")
  customerCount Int          @map("customer_count")
  invoiceCount  Int          @map("invoice_count")
  overdueCount  Int          @map("overdue_count")
  overdueCents  BigInt       @map("overdue_cents")
  warnings      Json         @default("[]")
  importedAt    DateTime     @default(now()) @map("imported_at")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices      FecInvoice[]

  @@unique([tenantId, fileHash])
  @@index([tenantId])
  @@map("fec_imports")
  @@schema("public")
}

/// Ticket 2.14 — import FEC (données CONFIDENTIELLES : dérivées du journal
/// comptable). Écriture uniquement via le script d'import, lecture via
/// withTenant. One row per customer invoice/receivable line extracted from a
/// `FecImport`; replacing an import purges its invoices (onDelete: Cascade).
/// Sealed by RLS (see the migration `rls_fec_import`).
model FecInvoice {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  importId      String    @map("import_id") @db.Uuid
  customerRef   String    @map("customer_ref")
  customerName  String?   @map("customer_name")
  number        String
  issuedDate    DateTime  @map("issued_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date
  amountCents   BigInt    @map("amount_cents")
  residualCents BigInt    @map("residual_cents")
  settled       Boolean
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  import        FecImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, settled])
  @@map("fec_invoices")
  @@schema("public")
}

/// Ticket 2.16 — classeur documentaire photo (justificatifs pris en photo par
/// l'utilisateur : factures fournisseurs, reçus, notes de frais). Données
/// CONFIDENTIELLES : `photo` est le document lui-même, jamais loggé.
/// `originalExtraction` est la sortie modèle FIGÉE (jamais réécrite après coup,
/// sert de matériau d'apprentissage) ; `extraction` porte les champs courants,
/// éventuellement corrigés par un humain — chaque correction s'ajoute à
/// `corrections` (append-only). `sha256` est l'empreinte du fichier — idempotence
/// par tenant (voir @@unique ci-dessous). Sealed by RLS (see the migration
/// `rls_classeur_documents`).
model ClasseurDocument {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  fileName              String    @map("file_name")
  mimeType              String    @map("mime_type")
  byteSize              Int       @map("byte_size")
  /// sha256 of the raw file — idempotency key (see @@unique below).
  sha256                String
  /// The document itself (photo) — CONFIDENTIAL, never logged.
  photo                 Bytes
  /// 'facture_fournisseur' | 'recu' | 'note_de_frais' | 'autre' — validated app-side by Zod.
  docType               String    @default("autre") @map("doc_type")
  /// 'a_verifier' | 'verifie' | 'rapproche' — validated app-side by Zod.
  status                String    @default("a_verifier")
  /// Current extracted fields (possibly human-corrected).
  extraction            Json?
  /// FROZEN model output — never rewritten afterwards (learning material).
  originalExtraction    Json?     @map("original_extraction")
  /// Append-only list of human corrections: [{by, at, fields}].
  corrections           Json      @default("[]")
  matchedTransactionId  String?   @map("matched_transaction_id")
  matchedAt             DateTime? @map("matched_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sha256])
  @@index([tenantId, status])
  @@map("classeur_documents")
  @@schema("public")
}

/// Ticket 3.2 — suivi des stocks + alertes. Un article de stock par tenant
/// (nom unique par tenant). `alertThreshold` pilote l'alerte de rupture côté
/// app (pas de logique métier en DB). Sealed by RLS (see the migration
/// `rls_stock_items_movements`).
model StockItem {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  name           String
  sku            String?
  unit           String          @default("unité")
  quantity       Int             @default(0)
  alertThreshold Int             @default(0) @map("alert_threshold")
  /// Replacement unit cost in cents (3.3) — financial data, owner-facing only.
  unitCostCents  Int             @default(0) @map("unit_cost_cents")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements      StockMovement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("stock_items")
  @@schema("public")
}

/// Ticket 3.2 — journal APPEND-ONLY des mouvements de stock (entrées/sorties).
/// `delta` est négatif pour une sortie, positif pour une entrée — jamais 0
/// (validé côté app). `createdBy` est l'utilisateur de la session, jamais un
/// input client non recontrôlé. Sealed by RLS (see the migration
/// `rls_stock_items_movements`).
model StockMovement {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  itemId    String    @map("item_id") @db.Uuid
  /// Négatif = sortie, positif = entrée — jamais 0 (validé côté app).
  delta     Int
  reason    String?
  /// User de session — jamais un input client non recontrôlé.
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId])
  @@map("stock_movements")
  @@schema("public")
}

/// Ticket 2.17 — notifications push Web/PWA. Un abonnement Web Push par
/// appareil navigateur (`endpoint` est l'URL du service push, unique tous
/// tenants confondus — un même appareil ne peut être abonné qu'une fois).
/// `userId` est l'utilisateur de session propriétaire de l'appareil (plan
/// AUTH séparé, pas de FK vers `users` — même logique que `PendingAction.requestedBy`).
/// `p256dh`/`auth` sont les clés de chiffrement de la subscription — sensibles
/// comme un secret d'appareil, jamais loggées. Sealed by RLS (see the migration
/// `rls_push_notifications`).
model PushSubscription {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// URL du service push navigateur. Unicité PAR TENANT : un même appareil
  /// peut servir plusieurs organisations (expert-comptable multi-tenants).
  endpoint        String
  /// Clés Web Push de la subscription — sensibles, jamais loggées.
  p256dh          String
  auth            String
  /// Libellé d'appareil (ex. user agent), pour affichage dans les réglages.
  userAgent       String?   @map("user_agent")
  actionsEnabled  Boolean   @default(true) @map("actions_enabled")
  alertsEnabled   Boolean   @default(true) @map("alerts_enabled")
  createdAt       DateTime  @default(now()) @map("created_at")
  lastUsedAt      DateTime? @map("last_used_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, endpoint])
  @@index([tenantId, userId])
  @@map("push_subscriptions")
  @@schema("public")
}

/// Ticket 2.17 — état de regroupement anti-spam des notifications push, une
/// ligne par (tenant, user, catégorie). Permet de fenêtrer/agréger les envois
/// (ex. ne pas notifier à chaque pending_action mais regrouper sur une fenêtre)
/// sans rejouer de logique métier en DB. Sealed by RLS (see the migration
/// `rls_push_notifications`).
model PushDispatchState {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// 'actions' | 'alerts' — validated app-side by Zod.
  category        String
  pendingCount    Int       @default(0) @map("pending_count")
  windowStartedAt DateTime? @map("window_started_at")
  lastSentAt      DateTime? @map("last_sent_at")
  lastSeenAt      DateTime? @map("last_seen_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category])
  @@map("push_dispatch_states")
  @@schema("public")
}

/// Ticket 2.19 — registre des immobilisations (amortissements). `source` distingue
/// une entrée reprise depuis le FEC (comptes 2xx/28x), issue d'un document du
/// classeur (facture d'achat), ou saisie manuelle. `priorDepreciationCents` porte
/// les amortissements déjà pratiqués AVANT l'entrée dans nodaq (reprise FEC 28x) —
/// jamais recalculés, juste reportés. `renewalCostCents` est le CAPEX de
/// renouvellement prévisionnel, éditable côté app (défaut = base historique).
model FixedAsset {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  label          String
  /// 'informatique' | 'logiciel' | 'vehicule' | 'materiel' | 'mobilier' | 'agencement'
  /// — validé côté app par Zod.
  category       String
  inServiceDate  DateTime  @map("in_service_date")
  baseCents      BigInt    @map("base_cents")
  durationMonths Int       @map("duration_months")
  /// 'LINEAIRE' | 'DEGRESSIF' — validé côté app par Zod.
  method         String    @default("LINEAIRE")
  /// 'FEC' | 'DOCUMENT' | 'MANUEL' — validé côté app par Zod.
  source         String    @default("MANUEL")
  sourceRef      String?   @map("source_ref")
  /// 'ACTIF' | 'CEDE' | 'SORTI' — validé côté app par Zod.
  status         String    @default("ACTIF")
  disposedAt     DateTime? @map("disposed_at")
  /// Amortissements déjà pratiqués AVANT l'entrée dans nodaq (reprise FEC 28x), en centimes.
  priorDepreciationCents BigInt  @default(0) @map("prior_depreciation_cents")
  renewalCostCents       BigInt? @map("renewal_cost_cents")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("fixed_assets")
  @@schema("public")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Schéma OPS (ticket 2.18) — support back-office. Exception ASSUMÉE à la RLS
/// métier : ces tables ne sont PAS tenant-scopées (un ticket peut n'avoir aucun
/// tenant, le recueil sert tous les tenants). Accès réservé aux routes
/// OPERATOR (allowlist plateforme) — jamais exposées aux routes tenant.
/// INTERDIT d'y stocker un corps d'e-mail brut : Object Storage uniquement,
/// référencé par clé (`objectKeys`).
/// ─────────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id         String    @id @default(uuid()) @db.Uuid
  /// Idempotence d'ingestion : re-poller la boîte ne crée jamais un doublon.
  messageId  String    @unique @map("message_id")
  fromEmail  String    @map("from_email")
  subject    String    @default("")
  /// Tenant identifié via From -> user -> memberships ; null = file générique.
  tenantId   String?   @map("tenant_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  /// USAGE | DONNEES_CONNECTEURS | BUG_PRODUIT (triage), null avant triage.
  origin     String?
  /// P1 | P2 | P3, null avant triage.
  level      String?
  /// NOUVEAU | TRIE | BROUILLON_PRET | REPONDU | RESOLU | SPAM.
  status     String    @default("NOUVEAU")
  /// Clés Object Storage du corps + pièces jointes (jamais le contenu ici).
  objectKeys Json      @default("[]") @map("object_keys")
  /// SPF/DKIM = signal (jamais une preuve d'identité).
  authSignal String?   @map("auth_signal")
  /// Brouillon de réponse GÉNÉRÉ (pas le corps entrant) — validé avant envoi.
  draftReply String?   @map("draft_reply")
  /// Diagnostic / rapport ANONYMISÉ produit par l'agent (jamais de donnée client).
  agentReport Json?    @map("agent_report")
  /// Fil e-mail (In-Reply-To à poser sur la réponse).
  inReplyTo  String?   @map("in_reply_to")
  repliedAt  DateTime? @map("replied_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
  @@schema("ops")
}

/// Recueil des problèmes : entrées CANONIQUES et ANONYMISÉES (aucune donnée
/// client — elles servent tous les tenants). Proposées par l'agent à la
/// résolution, validées par l'opérateur avant de devenir canoniques.
model SupportIssue {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  symptoms    String
  cause       String   @default("")
  resolution  String   @default("")
  /// USAGE | DONNEES_CONNECTEURS | BUG_PRODUIT.
  origin      String
  occurrences Int      @default(1)
  validated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([validated])
  @@map("support_issues")
  @@schema("ops")
}
