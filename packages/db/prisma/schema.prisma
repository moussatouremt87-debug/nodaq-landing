generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant = better-auth "organization" (plugin organization, mapped via modelName).
/// slug/logo/metadata are owned by the plugin; slug is unique (checked on create).
model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String?      @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  invitations Invitation[]
  notes       Note[]

  @@map("tenants")
}

/// Tables d'authentification (better-auth) : users, sessions, accounts, verifications.
/// Plan AUTH (pas métier) : un user peut appartenir à plusieurs tenants via memberships,
/// donc pas de tenant_id ni de RLS ici — le cloisonnement métier se fait via
/// memberships + withTenant (RLS) sur les tables métier.
model User {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @default("")
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
  invitations   Invitation[]

  @@map("users")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  token                String   @unique
  userId               String   @map("user_id") @db.Uuid
  /// Active organization (= tenant) of the session — the ONLY source of tenantId
  /// for business routes. Set by the organization plugin (set-active) or the
  /// session-create database hook.
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  expiresAt            DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// Membership = better-auth "member". Roles: owner | member | accountant
/// (plugin access control — string column, validated by the MembershipRole Zod
/// schema in @nodaq/shared at app boundaries).
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("memberships")
}

/// Invitation = better-auth "invitation" (organization plugin). Auth-plane table
/// (like memberships): accessed by the plugin outside withTenant, so no RLS.
model Invitation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String
  role      String?
  status    String   @default("pending")
  teamId    String?  @map("team_id")
  inviterId String   @map("inviter_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter   User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("invitations")
}

/// Table métier de démonstration : scellée par RLS (voir la migration `rls_notes`).
/// Toute nouvelle table métier suit le même pattern : tenant_id + policy RLS + test d'isolation.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notes")
}
