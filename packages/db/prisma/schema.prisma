generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  notes       Note[]

  @@map("tenants")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]

  @@map("users")
}

enum MembershipRole {
  OWNER
  MEMBER
  ACCOUNTANT
}

model Membership {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  role     MembershipRole
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("memberships")
}

/// Table métier de démonstration : scellée par RLS (voir la migration `rls_notes`).
/// Toute nouvelle table métier suit le même pattern : tenant_id + policy RLS + test d'isolation.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notes")
}
