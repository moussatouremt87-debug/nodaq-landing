/// Ticket 3.7 — profil tenant pour la veille réglementaire (secteur/effectif).
/// Une ligne par tenant (tenantId unique). `vertical` pilote quelles obligations
/// réglementaires sont pertinentes pour ce tenant — validé côté app par Zod
/// (`VERTICALS` dans `packages/shared/src/verticalPacks.ts` : les cinq métiers
/// de la cible du pivot + les cinq de l'ancien découpage, conservés), défense
/// en profondeur via CHECK en base. `headcountOverride` est l'effectif déclaré par
/// l'utilisateur ; si absent, l'effectif est dérivé de `staff_members` côté app
/// (jamais stocké en doublon ici). Sealed by RLS (see the migration
/// `rls_tenant_profiles`).
///
/// Ticket 2.9 — profil FISCAL (pilote la génération de l'échéancier fiscal &
/// social, `taxCalendar.ts`) : `vatRegime`/`payrollPeriodicity` valent
/// respectivement 'inconnu'/'aucune' PAR DÉFAUT — le produit ne DEVINE JAMAIS
/// le régime fiscal ou social d'une entreprise ; tant que l'owner n'a pas
/// renseigné son profil, l'échéancier le DIT explicitement au lieu d'inventer
/// des échéances. `corporateTaxLiable`/`fiscalYearEndMonth` pilotent les
/// échéances d'IS (acomptes/solde).
model TenantProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  vertical           String   @default("autre")
  headcountOverride  Int?     @map("headcount_override")
  /// Surcharges de modules (3.11) : map moduleId -> bool, choix explicites de
  /// l'owner par-dessus les défauts du vertical (moduleCatalog.ts).
  moduleOverrides    Json?    @map("module_overrides")
  /// 'inconnu' | 'franchise' | 'reel_simplifie' | 'reel_normal_mensuel' |
  /// 'reel_normal_trimestriel' — validé côté app par Zod, défense en
  /// profondeur via CHECK en base. 'inconnu' PAR DÉFAUT (jamais deviné).
  vatRegime          String   @default("inconnu") @map("vat_regime")
  /// Soumis à l'IS (impôt sur les sociétés) — pilote les échéances d'acomptes/solde.
  corporateTaxLiable Boolean  @default(true) @map("corporate_tax_liable")
  /// Mois de clôture de l'exercice (1..12) — défaut calendaire (décembre).
  fiscalYearEndMonth Int      @default(12) @map("fiscal_year_end_month")
  /// 'aucune' | 'mensuelle' | 'trimestrielle' — validé côté app par Zod,
  /// défense en profondeur via CHECK en base. 'aucune' PAR DÉFAUT (jamais
  /// deviné — pas de charges sociales inventées sans effectif déclaré).
  payrollPeriodicity String   @default("aucune") @map("payroll_periodicity")
  /// Coût horaire CHARGÉ, en centimes (4.1). NULL par défaut et jamais deviné :
  /// sans lui, le coût de main-d'oeuvre d'une affaire est INCONNU, et le calcul
  /// le dit au lieu de compter zéro heure de travail.
  hourlyCostCents    Int?     @map("hourly_cost_cents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
  @@schema("public")
}

/// Ticket 3.8 — avis clients / e-réputation. `source` distingue un avis saisi
/// manuellement d'un avis importé d'une plateforme (google | autre, futur —
/// V1 = saisie manuelle uniquement) ; `externalId` est l'identifiant chez la
/// plateforme d'origine, utilisé pour la déduplication à l'import (voir
/// @@unique ci-dessous — les NULL multiples passent en Postgres, donc l'unicité
/// ne joue que pour les avis importés). `authorName` est une PII (nom public de
/// l'auteur) — jamais loggé. `replyText`/`repliedAt` portent la réponse
/// VALIDÉE par un humain (HITL) : l'agent ne publie jamais directement (voir
/// CLAUDE.md règle 4). Sealed by RLS (see the migration
/// `rls_customer_reviews`).
model CustomerReview {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// 'manuel' | 'google' | 'autre' — validé côté app par Zod.
  source     String    @default("manuel")
  /// Identifiant chez la plateforme d'origine — clé de déduplication à l'import.
  externalId String?   @map("external_id")
  /// Nom public de l'auteur de l'avis — PII, jamais loggé.
  authorName String?   @map("author_name")
  /// Note 1..5 — défense en profondeur via CHECK en base.
  rating     Int
  text       String
  reviewedAt DateTime  @map("reviewed_at")
  /// Réponse VALIDÉE par un humain (HITL) — jamais publiée directement par l'agent.
  replyText  String?   @map("reply_text")
  repliedAt  DateTime? @map("replied_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, externalId])
  @@index([tenantId, reviewedAt])
  @@map("customer_reviews")
  @@schema("public")
}

/// Ticket 3.9 — assistant RGPD : registre des activités de traitement (art. 30
/// RGPD). Un traitement par tenant (nom unique par tenant). `legalBasis` est la
/// base légale — validée côté app par Zod (consentement | contrat |
/// obligation_legale | interet_legitime | mission_publique | interets_vitaux),
/// défense en profondeur via CHECK en base. `dataCategories`/`dataSubjects` sont
/// des tableaux de chaînes (Json) — catégories de données et personnes
/// concernées. `sensitiveData` signale un traitement de données art. 9 (santé,
/// origine, etc.) — jamais déduit automatiquement, déclaré côté app.
/// `sourceTemplate` référence l'id du modèle CNIL d'origine si le traitement a
/// été créé depuis un modèle pré-rempli (traçabilité, pas de contenu dupliqué).
/// Sealed by RLS (see the migration `rls_processing_activities`).
model ProcessingActivity {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  purpose        String
  /// 'consentement' | 'contrat' | 'obligation_legale' | 'interet_legitime' |
  /// 'mission_publique' | 'interets_vitaux' — validé côté app par Zod.
  legalBasis     String   @map("legal_basis")
  /// Tableau de chaînes (catégories de données traitées).
  dataCategories Json     @map("data_categories")
  /// Tableau de chaînes (personnes concernées : clients, salariés, prospects…).
  dataSubjects   Json     @map("data_subjects")
  recipients     String?
  /// Durée de conservation — texte libre sourcé (ex. « 5 ans après la fin du contrat »).
  retention      String
  /// Traitement de données art. 9 (santé, origine, opinions…) — déclaré côté app,
  /// jamais déduit automatiquement.
  sensitiveData  Boolean  @default(false) @map("sensitive_data")
  /// Id du modèle CNIL d'origine, si créé depuis un modèle pré-rempli.
  sourceTemplate String?  @map("source_template")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("processing_activities")
  @@schema("public")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Socle webhooks entrants (ticket 2.13). Une requête webhook n'a AUCUNE
/// session applicative : il faut résoudre l'endpoint (et donc le tenant) AVANT
/// de pouvoir ouvrir withTenant(). Voir withWebhookResolver() (src/index.ts) et
/// la policy SELECT gated `webhook_resolver_lookup` (migration RLS dédiée).
/// ─────────────────────────────────────────────────────────────────────────────

/// Un endpoint par (tenant, provider) — la rotation de secret remplace la ligne,
/// elle n'en crée pas une deuxième. `secretRef` = référence coffre UNIQUEMENT,
/// jamais le secret de signature en clair.
model WebhookEndpoint {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  /// 'pdp' | 'bridge' | 'pennylane' | 'qonto' | 'test' — validé côté app par Zod.
  provider    String
  /// Référence Secret Manager du secret de signature — jamais la valeur.
  secretRef   String         @map("secret_ref")
  active      Boolean        @default(true)
  description String         @default("")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events      WebhookEvent[]

  @@unique([tenantId, provider])
  @@map("webhook_endpoints")
  @@schema("public")
}

/// Événement webhook reçu. Idempotence par (tenant, provider, externalId) :
/// un fournisseur qui rejoue un événement ne duplique jamais la ligne.
model WebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  endpointId  String          @map("endpoint_id") @db.Uuid
  provider    String
  /// Id de l'événement chez le fournisseur — clé d'idempotence.
  externalId  String          @map("external_id")
  eventType   String          @default("") @map("event_type")
  payload     Json
  /// 'received' | 'processed' | 'ignored' | 'failed' — validé côté app par Zod.
  status      String          @default("received")
  attempts    Int             @default(0)
  error       String?
  receivedAt  DateTime        @default(now()) @map("received_at")
  processedAt DateTime?       @map("processed_at")
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, status])
  @@map("webhook_events")
  @@schema("public")
}

/// Ticket 2.4 — soumission PDP de factures électroniques (Factur-X). Suivi de
/// dépôt UNIQUEMENT : cette table ne stocke NI le PDF NI le XML de la facture,
/// seulement un hash d'intégrité (`documentHash`) et des métadonnées de suivi
/// (statut, référence PDP, historique horodaté). `lastError` porte un NOM
/// d'erreur seulement — jamais un message qui citerait le contenu de la
/// facture. `@@unique([tenantId, invoiceNumber, direction])` rend le dépôt
/// idempotent : une même facture n'est déposée qu'une fois par sens de flux.
/// Sealed by RLS (see the migration `rls_einvoice_submissions`).
model EInvoiceSubmission {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  invoiceNumber String    @map("invoice_number")
  /// 'BASIC' | 'EN16931' — profil Factur-X utilisé, validé côté app par Zod.
  profile       String
  /// 'emission' | 'ereporting' — validé côté app par Zod.
  direction     String    @default("emission")
  /// 'prete' | 'deposee' | 'recue' | 'prise_en_charge' | 'approuvee' |
  /// 'approuvee_partiellement' | 'refusee' | 'rejetee' | 'encaissee' | 'erreur'
  /// — validé côté app par Zod.
  status        String    @default("prete")
  /// Identifiant du dépôt chez la plateforme (PDP) — absent tant que non déposé.
  pdpReference  String?   @map("pdp_reference")
  /// sha256 du PDF soumis — preuve d'intégrité, JAMAIS le document lui-même.
  documentHash  String    @map("document_hash")
  /// TTC, pour l'affichage du suivi.
  amountCents   Int       @map("amount_cents")
  currency      String    @default("EUR")
  /// Historique horodaté des statuts : [{status, at, reference?}] — append-only côté app.
  statusHistory Json      @default("[]") @map("status_history")
  /// Nom d'erreur SEULEMENT — jamais un message qui citerait la facture.
  lastError     String?   @map("last_error")
  submittedAt   DateTime? @map("submitted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber, direction])
  @@index([tenantId, status])
  @@map("einvoice_submissions")
  @@schema("public")
}

/// Ticket 2.9 — échéancier fiscal & social. Le calendrier lui-même est
/// CALCULÉ (catalogue versionné `taxCalendar.ts` + profil fiscal du tenant),
/// JAMAIS stocké : cette table ne porte QUE des surcharges HUMAINES posées
/// par l'owner sur une occurrence dérivée précise (obligation + échéance).
/// `amountCents` est le montant DÉCLARÉ par l'owner ; NULL = inconnu, jamais
/// estimé par le produit. `@@unique([tenantId, obligationId, dueDate])`
/// garantit une seule surcharge par occurrence. Sealed by RLS (see the
/// migration `rls_tax_deadlines`).
model TaxDeadline {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Identifiant de l'obligation dans le catalogue versionné (`taxCalendar.ts`).
  obligationId String   @map("obligation_id")
  /// Échéance concernée — une occurrence précise (le calendrier peut être récurrent).
  dueDate      DateTime @map("due_date") @db.Date
  /// Montant DÉCLARÉ par l'owner, en centimes — NULL = inconnu, jamais estimé.
  amountCents  Int?     @map("amount_cents")
  /// 'prevu' | 'paye' | 'non_applicable' — validé côté app par Zod, défense
  /// en profondeur via CHECK en base.
  status       String   @default("prevu")
  /// Annotation libre de l'owner — bornée côté app à 500 caractères.
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, obligationId, dueDate])
  @@index([tenantId, dueDate])
  @@map("tax_deadlines")
  @@schema("public")
}

/// Ticket 2.12 — CRM & prospection. PREMIÈRE table qui porte les données de
/// personnes qui ne sont PAS clientes : `name`, `company`, `email` et `phone`
/// sont des données personnelles de tiers. D'où deux colonnes qui ne sont pas
/// du confort produit mais des obligations :
///   - `source` : provenance DÉCLARÉE, non nullable (art. 14 — on doit pouvoir
///     dire d'où vient une donnée non collectée auprès de la personne) ;
///   - `optedOut` / `optedOutAt` : opposition (art. 21). La fiche opposée est
///     retirée de toute liste par le moteur (`prospection.ts`) ; on la GARDE
///     minimale plutôt que de la supprimer, sinon la même personne serait
///     réimportée demain — c'est une liste d'exclusion.
/// Le dernier contact n'est PAS une colonne : il est DÉRIVÉ du journal
/// append-only `prospect_interactions` (doctrine 2.9/2.16b). Sealed by RLS
/// (see the migration `rls_prospects`).
model Prospect {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  /// Donnée personnelle d'un tiers — bornée côté app, jamais loguée.
  name         String
  company      String?
  email        String?
  phone        String?
  /// Étape du pipeline : 'nouveau'|'contacte'|'qualifie'|'devis_envoye'|'gagne'|'perdu'.
  stage        String                @default("nouveau")
  /// Provenance de la fiche — enum fermé validé par Zod, CHECK en base.
  source       String
  /// Opposition à la prospection : exclusion structurelle des relances.
  optedOut     Boolean               @default(false) @map("opted_out")
  optedOutAt   DateTime?             @map("opted_out_at")
  /// Annotation libre — bornée côté app à 1 000 caractères.
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interactions ProspectInteraction[]
  affaires     Affaire[]

  @@unique([tenantId, id])
  @@index([tenantId, stage])
  @@index([tenantId, optedOut])
  @@map("prospects")
  @@schema("public")
}

/// Ticket 2.8 — charges d'un mois, par poste. Une marge se calcule sur ce qui
/// est CONNU : un poste sans ligne est un poste MANQUANT (le moteur ne produit
/// alors qu'une borne supérieure), jamais un poste à zéro. D'où l'absence de
/// toute valeur par défaut et l'unicité (tenant, mois, poste, source) : un
/// import FEC rejoué met à jour SA ligne sans écraser une saisie humaine.
/// `amountCents` peut être NÉGATIF (avoirs supérieurs aux achats du mois) — le
/// ramener à zéro fabriquerait une charge inexistante. Sealed by RLS (see the
/// migration `rls_cost_entries`).
model CostEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// "YYYY-MM" — mois de rattachement de la charge.
  month       String
  /// Poste du catalogue versionné `costCategories.ts`.
  category    String
  amountCents Int      @map("amount_cents")
  /// 'fec' (dérivée d'un import comptable) | 'saisi' (déclarée par l'owner).
  source      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month, category, source])
  @@index([tenantId, month])
  @@map("cost_entries")
  @@schema("public")
}

/// Ticket 2.12 — LISTE D'EXCLUSION. C'est elle, et non la fiche conservée, qui
/// empêche réellement de recontacter une personne opposée : l'opposition efface
/// e-mail et téléphone, donc sans cette table la même personne serait resaisie
/// le lendemain et repartirait en tête des relances.
///
/// Ne porte AUCUNE donnée en clair : uniquement un condensat SHA-256 de la
/// coordonnée normalisée, salé par le `tenantId` (deux tenants ne peuvent pas
/// rapprocher leurs listes, et un condensat volé ne redonne pas l'adresse).
/// Limite assumée : l'espace des adresses e-mail reste énumérable — c'est un
/// verrou anti-réimport, pas un secret. Sealed by RLS (see `rls_prospects`).
model ProspectExclusion {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// SHA-256(tenantId + ':' + coordonnée normalisée). Jamais la coordonnée.
  contactHash String   @map("contact_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactHash])
  @@map("prospect_exclusions")
  @@schema("public")
}

/// Ticket 2.12 — journal des contacts, APPEND-ONLY. C'est la SEULE source du
/// « dernier contact » : un champ modifiable sur la fiche finirait par mentir
/// (et déciderait alors, seul, qui est relancé).
model ProspectInteraction {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
  /// 'appel' | 'email' | 'rdv' | 'autre' — Zod côté app, CHECK en base.
  kind       String
  occurredAt DateTime @map("occurred_at")
  /// Compte rendu court — borné côté app à 1 000 caractères.
  note       String?
  /// Utilisateur qui a consigné le contact (attribution).
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([tenantId, prospectId, occurredAt])
  @@map("prospect_interactions")
  @@schema("public")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Schéma OPS (ticket 2.18) — support back-office. Exception ASSUMÉE à la RLS
/// métier : ces tables ne sont PAS tenant-scopées (un ticket peut n'avoir aucun
/// tenant, le recueil sert tous les tenants). Accès réservé aux routes
/// OPERATOR (allowlist plateforme) — jamais exposées aux routes tenant.
/// INTERDIT d'y stocker un corps d'e-mail brut : Object Storage uniquement,
/// référencé par clé (`objectKeys`).
/// ─────────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String    @id @default(uuid()) @db.Uuid
  /// Idempotence d'ingestion : re-poller la boîte ne crée jamais un doublon.
  messageId   String    @unique @map("message_id")
  fromEmail   String    @map("from_email")
  subject     String    @default("")
  /// Tenant identifié via From -> user -> memberships ; null = file générique.
  tenantId    String?   @map("tenant_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  /// USAGE | DONNEES_CONNECTEURS | BUG_PRODUIT (triage), null avant triage.
  origin      String?
  /// P1 | P2 | P3, null avant triage.
  level       String?
  /// NOUVEAU | TRIE | BROUILLON_PRET | REPONDU | RESOLU | SPAM.
  status      String    @default("NOUVEAU")
  /// Clés Object Storage du corps + pièces jointes (jamais le contenu ici).
  objectKeys  Json      @default("[]") @map("object_keys")
  /// SPF/DKIM = signal (jamais une preuve d'identité).
  authSignal  String?   @map("auth_signal")
  /// Brouillon de réponse GÉNÉRÉ (pas le corps entrant) — validé avant envoi.
  draftReply  String?   @map("draft_reply")
  /// Diagnostic / rapport ANONYMISÉ produit par l'agent (jamais de donnée client).
  agentReport Json?     @map("agent_report")
  /// Fil e-mail (In-Reply-To à poser sur la réponse).
  inReplyTo   String?   @map("in_reply_to")
  repliedAt   DateTime? @map("replied_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
  @@schema("ops")
}

/// Recueil des problèmes : entrées CANONIQUES et ANONYMISÉES (aucune donnée
/// client — elles servent tous les tenants). Proposées par l'agent à la
/// résolution, validées par l'opérateur avant de devenir canoniques.
model SupportIssue {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  symptoms    String
  cause       String   @default("")
  resolution  String   @default("")
  /// USAGE | DONNEES_CONNECTEURS | BUG_PRODUIT.
  origin      String
  occurrences Int      @default(1)
  validated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([validated])
  @@map("support_issues")
  @@schema("ops")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Ticket 4.1 — L'OBJET AFFAIRE, pivot du produit (ADR-007).
///
/// Une affaire = un chantier, un événement, une intervention, une mission. Le
/// MOT vient du pack vertical, jamais du code (`verticalPacks.ts`, 4.2).
///
/// Deux règles de structure, non négociables :
///  1. TOUT rattachement est NULLABLE. Une pièce sans affaire (essence,
///     assurance, frais généraux) est le cas MAJORITAIRE au démarrage, et
///     l'existant doit continuer de fonctionner sans connaître les affaires.
///  2. Une affaire ne se SUPPRIME jamais — des pièces comptables y sont
///     rattachées. Statut ARCHIVEE, et archiver ne détache rien.
/// ─────────────────────────────────────────────────────────────────────────────

/// Le client n'est PAS une clé étrangère vers une table `contacts` : cette
/// table n'existe pas dans le produit. `clientName` est un libellé de
/// contrepartie commerciale (saisi ou repris d'une pièce) ; `prospectId` relie
/// à une fiche de prospection QUAND l'affaire en vient — nullable, et mis à
/// NULL si la fiche est effacée (une opposition RGPD ne doit pas emporter le
/// chantier, qui a sa propre base légale : l'exécution du contrat).
model Affaire {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  /// « 2026-014 » — unique par tenant, générée par `affaire_counters` (compteur
  /// atomique), jamais par un count()+1.
  reference              String
  label                  String
  clientName             String?             @map("client_name")
  prospectId             String?             @map("prospect_id") @db.Uuid
  /// PROSPECT | DEVIS_ENVOYE | ACCEPTEE | EN_COURS | TERMINEE | PERDUE |
  /// ARCHIVEE — Zod côté app, CHECK en base (défense en profondeur).
  status                 String              @default("PROSPECT")
  address                String?
  /// Coordonnées optionnelles, pour le rapprochement géographique (F2). Jamais
  /// devinées : renseignées seulement si l'utilisateur les fournit.
  latitude               Float?
  longitude              Float?
  /// Montant DEVISÉ HT en centimes. NULL = pas de devis : on affiche alors les
  /// coûts, et AUCUNE marge (une marge sans devis serait inventée).
  quotedAmountCents      BigInt?             @map("quoted_amount_cents")
  /// Taux de TVA en points de base (2000 = 20 %). Entier : pas de flottant sur
  /// une donnée fiscale.
  vatRateBps             Int?                @map("vat_rate_bps")
  estimatedHours         Int?                @map("estimated_hours")
  /// Heures réellement passées, DÉCLARÉES : il n'existe pas de lignes de temps
  /// dans le produit. NULL = inconnu (marge en borne supérieure), 0 = déclaré nul.
  hoursWorked            Int?                @map("hours_worked")
  /// Coût matière PRÉVU au devis — seule référence possible de l'écart budget.
  estimatedMaterialCents BigInt?             @map("estimated_material_cents")
  /// Acomptes encaissés, déclarés. Jamais comptés en marge acquise.
  depositsCents          BigInt?             @map("deposits_cents")
  /// Retenue de garantie (US-8/US-9) : taux en points de base et date de
  /// libération. Elle est EXCLUE du reste à facturer et affichée à part —
  /// relancer un client sur sa retenue est la faute qui coûte un client.
  retentionRateBps       Int?                @map("retention_rate_bps")
  retentionReleaseDate   DateTime?           @map("retention_release_date") @db.Date
  startDate              DateTime?           @map("start_date") @db.Date
  plannedEndDate         DateTime?           @map("planned_end_date") @db.Date
  actualEndDate          DateTime?           @map("actual_end_date") @db.Date
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at")
  /// Contrat récurrent (4.2 bloc 2) dont cette affaire matérialise une
  /// échéance — NULLABLE, sans exception (règle de structure n°1) : la
  /// majorité des affaires ne viennent d'aucun contrat.
  contratId              String?             @map("contrat_id") @db.Uuid
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospect               Prospect?           @relation(fields: [tenantId, prospectId], references: [tenantId, id], onDelete: SetNull)
  contrat                Contrat?            @relation(fields: [tenantId, contratId], references: [tenantId, id], onDelete: SetNull)
  imputations            AffaireImputation[]
  classeurDocuments      ClasseurDocument[]
  fecInvoices            FecInvoice[]
  pendingActions         PendingAction[]

  @@unique([tenantId, reference])
  /// Cible de la clé étrangère COMPOSITE des imputations : l'intégrité
  /// référentielle contourne la RLS, donc sans elle une imputation d'un tenant
  /// pouvait pointer l'affaire d'un AUTRE tenant.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, prospectId])
  @@index([tenantId, contratId])
  @@map("affaires")
  @@schema("public")
}

/// Compteur de référence PAR TENANT ET PAR ANNÉE.
///
/// Le piège du ticket : `count() + 1` donne deux fois « 2026-014 » à deux
/// créations simultanées. Ici l'incrément est un UPSERT atomique
/// (`ON CONFLICT DO UPDATE ... RETURNING`) : le verrou de ligne Postgres
/// sérialise les concurrents, et l'unicité (tenantId, reference) sur
/// `affaires` reste le dernier rempart.
model AffaireCounter {
  tenantId  String   @map("tenant_id") @db.Uuid
  year      Int
  nextSeq   Int      @default(0) @map("next_seq")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, year])
  @@map("affaire_counters")
  @@schema("public")
}

/// Imputation d'une pièce à une affaire — APPEND-ONLY, révocable.
///
/// POLYMORPHE par nécessité, pas par goût : les transactions bancaires ne sont
/// PAS stockées dans le produit (elles vivent chez Qonto/Bridge, on n'en garde
/// qu'un identifiant externe, cf. `classeur_documents.matched_transaction_id`),
/// et ni les lignes de temps ni les devis n'ont de table. Une colonne
/// `affaireId` ne peut donc exister que là où une table existe : c'est cette
/// table-ci qui porte le rattachement dans le cas général.
///
/// Défaire = `revokedAt`, jamais DELETE : c'est la trace qui alimentera
/// l'apprentissage (F2) et qui permet d'expliquer un chiffre a posteriori.
model AffaireImputation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  affaireId   String    @map("affaire_id") @db.Uuid
  /// 'classeur_document' | 'transaction_bancaire' | 'facture' | 'charge' —
  /// Zod côté app, CHECK en base.
  targetType  String    @map("target_type")
  /// UUID interne, ou identifiant EXTERNE pour une transaction bancaire.
  targetId    String    @map("target_id")
  /// AUTO (suggérée, non confirmée) | CONFIRMEE (suggestion validée par un
  /// humain) | MANUELLE. La distinction est ce qui rendra F2 mesurable.
  source      String    @default("MANUELLE")
  /// Instantané du montant AU MOMENT de l'imputation, en centimes. Nullable :
  /// une pièce dont on ne connaît pas le montant s'impute quand même — c'est
  /// le calcul qui DIRA qu'il lui manque des montants.
  amountCents BigInt?   @map("amount_cents")
  /// 'ht' | 'ttc' — base du montant ci-dessus. JAMAIS de conversion TTC→HT :
  /// sans le taux réel de la pièce, ce serait un chiffre inventé. Le calcul
  /// tient les deux séparément et le dit.
  amountBasis String?   @map("amount_basis")
  /// Marque une facture de SOUS-TRAITANCE (poste de coût distinct au devis).
  subcontract Boolean   @default(false)
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy   String?   @map("revoked_by")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affaire     Affaire   @relation(fields: [tenantId, affaireId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, affaireId, revokedAt])
  @@index([tenantId, targetType, targetId])
  @@map("affaire_imputations")
  @@schema("public")
}

/// Ticket 4.2 bloc 2 — contrats récurrents (entretien, maintenance, forfait
/// mensuel) : le vocabulaire vient du pack vertical, jamais du code. Un
/// contrat ne CRÉE aucune affaire lui-même — `lastOccurrenceDate` ne fait que
/// tracer la dernière échéance déjà matérialisée en affaire, pour que le
/// moteur de génération sache où reprendre. `amountCents` est le montant HT
/// PAR PÉRIODE (mensuel/trimestriel/semestriel/annuel selon `cadence`),
/// JAMAIS le total du contrat — un contrat récurrent n'a pas de fin connue
/// tant qu'il n'est pas résilié. `@@unique([tenantId, id])` est la cible de
/// la clé étrangère composite portée par `affaires.contrat_id` (même
/// mécanisme que `affaires`/`affaire_imputations` en 4.1) : sans elle,
/// l'intégrité référentielle (qui contourne la RLS) laisserait une affaire
/// d'un tenant pointer le contrat d'un AUTRE tenant.
model Contrat {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  label              String
  clientName         String?   @map("client_name")
  /// 'mensuel' | 'trimestriel' | 'semestriel' | 'annuel' — validé côté app par
  /// Zod, défense en profondeur via CHECK en base.
  cadence            String
  /// Montant HT PAR PÉRIODE, en centimes — jamais le total du contrat.
  amountCents        BigInt?   @map("amount_cents")
  vatRateBps         Int?      @map("vat_rate_bps")
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  /// Dernière échéance déjà matérialisée en affaire — repère de reprise pour
  /// le moteur de génération, jamais recalculée a posteriori.
  lastOccurrenceDate DateTime? @map("last_occurrence_date") @db.Date
  /// 'ACTIF' | 'SUSPENDU' | 'TERMINE' — validé côté app par Zod, défense en
  /// profondeur via CHECK en base.
  status             String    @default("ACTIF")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affaires           Affaire[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("contrats")
  @@schema("public")
}
